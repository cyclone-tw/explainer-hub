// Cloudflare Workers 靜態部署：docs/ 直接成為 explainer-hub.cyclonetw.dev（#5）。
// GitHub Pages 仍由 docs/ 提供，兩個網址並存。
{
  "name": "explainer-hub",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./docs" },
  "routes": [
    { "pattern": "explainer-hub.cyclonetw.dev", "custom_domain": true }
  ]
}
